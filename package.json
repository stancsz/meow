{
  "name": "meow-swarm",
  "version": "0.3.0",
  "type": "module",
  "description": "meow -p: Autonomous multi-agent coding harness. Run coding agents in background, checkpoint state, TUI dashboard.",
  "main": "./dist/bin/meow.js",
  "bin": {
    "meow": "./dist/bin/meow.js",
    "meow-mcp": "./dist/bin/meow-mcp.js",
    "meow-eval": "./dist/bin/meow-eval.js",
    "meow-skills": "./dist/bin/meow-skills.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "tui": "tsx src/index.ts --tui",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "prepare": "husky install",
    "build": "tsup --config tsup.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/blessed": "^0.1.27",
    "@types/fluent-ffmpeg": "2.1.28",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "diff-match-patch": "^1.0.5",
    "fluent-ffmpeg": "2.1.3",
    "globby": "16.2.0",
    "js-yaml": "4.1.1",
    "mathjs": "^15.2.0",
    "picocolors": "1.1.1",
    "quantum-circuit": "^0.9.247",
    "sqlite-vec": "^0.1.9",
    "uuid": "^11.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "latest",
    "@types/diff-match-patch": "^1.0.36",
    "@types/js-yaml": "4.0.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "meow-p",
    "meow",
    "swarm",
    "coding",
    "agent",
    "autonomous",
    "background",
    "daemon",
    "harness",
    "orchestration",
    "checkpoint",
    "tui",
    "claude"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.js"
  }
}
