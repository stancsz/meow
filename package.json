{
  "name": "meow",
  "version": "0.1.0",
  "type": "module",
  "description": "MEOW \u2014 Autonomous multi-agent coding harness with quality gates, convergence logic, and long-running task support",
  "main": "src/index.js",
  "bin": {
    "meow": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "tui": "tsx src/index.ts --tui",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "prepare": "husky install"
  },
  "dependencies": {
    "@clack/prompts": "1.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/blessed": "^0.1.27",
    "@types/fluent-ffmpeg": "2.1.28",
    "better-sqlite3": "^12.9.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "diff-match-patch": "^1.0.5",
    "fluent-ffmpeg": "2.1.3",
    "globby": "16.2.0",
    "js-yaml": "4.1.1",
    "mathjs": "^15.2.0",
    "picocolors": "1.1.1",
    "quantum-circuit": "^0.9.247",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "latest",
    "@types/diff-match-patch": "^1.0.36",
    "@types/js-yaml": "4.0.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "author": "stancsz <stancsz@example.com>",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "autonomous",
    "multi-agent",
    "llm",
    "claude",
    "claude-code",
    "hermes",
    "coding-harness",
    "quality-gates",
    "typescript",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stancsz/meow.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
