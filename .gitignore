# Dependencies
node_modules/

# Environment
.env
.env.local

# Runtime state (meow-swarm daemon)
.meow/
tmp/
memory/

# Claude Code — ephemeral session state (not portable)
.claude/README.md
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Skills are tracked — but ignore their embedded git repos and caches
.claude/skills/*/.git/
.claude/skills/*/__pycache__/
.claude/skills/*/*.pyc

# Build output
dist/
build/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

